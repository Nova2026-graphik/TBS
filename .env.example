# ─────────────────────────────────────────────────────────────────────────────
# TBS Distribution — variables d'environnement
# Copiez ce fichier en `.env` et renseignez les valeurs.
# Nuxt mappe automatiquement NUXT_<CLE> sur runtimeConfig.<cle>.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL. Laissez vide pour faire tourner le site sur son contenu statique
# (aucune base requise pour le développement ou une mise en ligne rapide).
#
# Supabase — « Connection string » > Transaction pooler (port 6543) :
#   postgresql://postgres.<ref>:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Neon :
#   postgresql://<user>:<mot-de-passe>@<host>.neon.tech/<db>?sslmode=require
# Postgres local :
#   postgresql://postgres:postgres@localhost:5432/tbs
DATABASE_URL=

# Taille du pool de connexions (5 par défaut ; 1 à 3 en serverless).
DATABASE_POOL_MAX=5

# Adresse qui reçoit la notification de nouvelle demande de devis.
NUXT_NOTIFY_EMAIL=tbstogo228@gmail.com

# Nombre maximal de demandes de devis par IP et par heure.
NUXT_QUOTE_RATE_LIMIT_PER_HOUR=10

# URL publique du site (canoniques, Open Graph, sitemap).
NUXT_PUBLIC_SITE_URL=https://www.tbs-distribution.tg
