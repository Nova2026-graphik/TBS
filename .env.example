# ─────────────────────────────────────────────────────────────────────────────
# TBS Distribution — variables d'environnement
# Copiez ce fichier en `.env` et renseignez les valeurs.
# Nuxt mappe automatiquement NUXT_<CLE> sur runtimeConfig.<cle>.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL. Laissez vide pour faire tourner le site sur son contenu statique
# (aucune base requise pour le développement ou une mise en ligne rapide).
#
# Supabase — « Connection string » > Transaction pooler (port 6543) :
#   postgresql://postgres.<ref>:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Neon :
#   postgresql://<user>:<mot-de-passe>@<host>.neon.tech/<db>?sslmode=require
# Postgres local :
#   postgresql://postgres:postgres@localhost:5432/tbs
DATABASE_URL=

# Taille du pool de connexions (5 par défaut ; 1 à 3 en serverless).
DATABASE_POOL_MAX=5

# Adresse qui reçoit la notification de nouvelle demande de devis.
NUXT_NOTIFY_EMAIL=tbstogo228@gmail.com

# Envoi des notifications de devis. Sans clé, l'envoi est simplement désactivé :
# la demande reste enregistrée en base et journalisée, le formulaire ne casse pas.
#
# Prestataire : `resend` ou `brevo`. Brevo a la meilleure délivrabilité en
# Afrique de l'Ouest ; Resend est le plus simple à mettre en route.
NUXT_MAIL_PROVIDER=resend

# Clé d'API du prestataire (Resend : `re_…` · Brevo : `xkeysib-…`).
NUXT_MAIL_API_KEY=

# Expéditeur. Le domaine doit être vérifié chez le prestataire (SPF + DKIM),
# sans quoi les messages partent en indésirables — ou sont refusés.
NUXT_MAIL_FROM=TBS Distribution <devis@tbs-distribution.tg>

# Nombre maximal de demandes de devis par IP et par heure. Le compte est tenu
# en base — table `quote_requests`, fenêtre glissante — donc partagé entre
# toutes les instances. Sans DATABASE_URL, il retombe en mémoire du processus.
NUXT_QUOTE_RATE_LIMIT_PER_HOUR=10

# URL publique du site (canoniques, Open Graph, sitemap).
NUXT_PUBLIC_SITE_URL=https://www.tbs-distribution.tg

# ─────────────────────────────────────────────────────────────────────────────
# Référencement local
# ─────────────────────────────────────────────────────────────────────────────

# Coordonnées de l'entrepôt d'Agôè-Démakpoè, à relever SUR PLACE.
#
#   Google Maps : clic long (ou clic droit) sur le portail de l'entrepôt,
#                 les deux nombres s'affichent — latitude d'abord.
#   Sur place   : n'importe quelle application boussole ou GPS.
#
# Tant qu'elles sont vides, le JSON-LD n'annonce aucune position et la carte de
# /contact reste sur son cadrage de quartier. C'est voulu : une latitude
# approximative publiée comme un fait est reprise telle quelle par les moteurs
# et envoie un chauffeur à un kilomètre de l'entrepôt.
#
# Une valeur hors des bornes du Togo est ignorée avec un avertissement —
# l'erreur la plus courante étant d'intervertir les deux nombres.
NUXT_PUBLIC_GEO_LATITUDE=
NUXT_PUBLIC_GEO_LONGITUDE=

# Fiche d'établissement Google, une fois créée et validée. Alimente `hasMap` et
# `sameAs` dans le JSON-LD — c'est ce qui relie le site à la fiche aux yeux
# d'un moteur.
NUXT_PUBLIC_GOOGLE_BUSINESS_URL=

# ─────────────────────────────────────────────────────────────────────────────
# En-têtes de sécurité (server/plugins/security-headers.ts)
# ─────────────────────────────────────────────────────────────────────────────

# Mode de la Content-Security-Policy :
#   report-only (défaut) — les violations sont signalées dans la console du
#                          navigateur, rien n'est bloqué ;
#   enforce              — la politique bloque. Renseignez d'abord
#                          NUXT_SECURITY_CSP_SCRIPT_HASHES, sinon l'hydratation
#                          est coupée.
NUXT_SECURITY_CSP_MODE=report-only

# Empreintes des scripts en ligne des pages pré-rendues, séparées par une
# virgule. À régénérer après chaque build :
#   npm run build && npm run security:csp-hashes
NUXT_SECURITY_CSP_SCRIPT_HASHES=

# Ce qui se trouve devant l'application. Détermine quel en-tête peut être cru
# pour identifier le client — c'est de cette adresse que dépend la limitation
# de débit du formulaire de devis.
#
#   direct (défaut)  — accès direct : aucun en-tête n'est lu, seule l'adresse
#                      de la connexion TCP fait foi. Prudent, et faux si un
#                      proxy se trouve devant : tout le monde partage alors le
#                      même quota.
#   cloudflare       — lit `cf-connecting-ip`
#   vercel           — lit `x-vercel-forwarded-for`
#   netlify          — lit `x-nf-client-connection-ip`
#   x-forwarded-for  — lit `X-Forwarded-For`, en ne gardant que les entrées
#                      écrites par vos propres proxys (voir _HOPS)
#
# À ne renseigner que si la plate-forme nommée est réellement devant : ces
# en-têtes sont dignes de foi parce qu'elle les réécrit. En accès direct, un
# robot les fabrique et traverse la limitation.
NUXT_SECURITY_TRUSTED_PROXY=direct

# Nombre de proxys de confiance entre le client et l'application, pour le seul
# mode `x-forwarded-for`. 1 = un seul reverse proxy (Nginx, Traefik…).
NUXT_SECURITY_TRUSTED_PROXY_HOPS=1
